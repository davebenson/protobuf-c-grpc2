prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: libprotobuf-c-grpc2-openssl
Description: OpenSSL secure transport for protobuf-c-grpc2
Version: @VERSION@
Requires: libprotobuf-c-grpc2 openssl
Libs: -L${libdir} -lprotobuf-c-grpc2-openssl
Cflags: -I${includedir}
